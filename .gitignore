@'
# Python
__pycache__/
*.py[cod]
*.pyd
*.egg-info/
build/
dist/

# Virtual environments
venv/
.venv/
env/

# IDE
.vscode/
.idea/

# Environment variables and secrets
.env
.env.*
!.env.example

# Pytest and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Generated reports
reports/*
!reports/.gitkeep

# Screenshots and temporary files
screenshots/
*.tmp
*.bak

# Local databases
*.db
*.sqlite
*.sqlite3

# Logs
*.log

# Operating system
.DS_Store
Thumbs.db
desktop.ini
'@ | Set-Content .gitignore -Encoding UTF8